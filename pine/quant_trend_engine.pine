//@version=5
// ════════════════════════════════════════════════════════════════════
//  QUANT TREND ENGINE [SMP]
//  Zaman-serisi momentum / trend-takibi + volatilite-hedefli boyutlandirma.
//
//  Bu strateji, retail ICT/SMC "sihirli setup" mantigi DEGIL — kripto'da
//  bagimsiz akademik kanitla desteklenen tek saglam edge ailesi olan
//  TREND-TAKIBI uzerine kuruludur. Python'da 9-coin sepetinde, walk-forward
//  ile dogrulandi: gunluk (1D) long-only portfoy Sharpe ~0.6-0.8, CAGR
//  ~%10-16, MaxDD ~%20-32 (bkz. STRATEJI_RAPORU.md / backtest/run_trend.py).
//
//  DURUST BEKLENTI: bu bir para makinesi degil. Pozitif beklentili ama
//  DRAWDOWN'lu, dusuk-Sharpe sağlam bir sistem. "Gunde %5" imkansiz.
//  Edge esas olarak COK COINE uygulayip cesitlendirmekten gelir (breadth) —
//  tek coinde Sharpe daha dusuktur. En iyi: 1D, BTC/ETH/SOL/BNB/... sepeti.
//
//  Cekirdek kurallar (Python'da dogrulanan "donchian 20/10 t100 LO"):
//    - Trend filtresi: close > EMA(trendLen)  -> sadece long tarafi acik
//    - Giris: close, son entryLen barin en yuksegini kirar (Donchian breakout)
//    - Cikis: close, son exitLen barin en dusugunun altina iner (Donchian)
//    - Boyut: volatilite hedefleme -> lev = min(hedefVol / gerceklesmisVol, maxLev)
//    - Opsiyonel ATR trailing stop (ek guvenlik; varsayilan kapali)
// ════════════════════════════════════════════════════════════════════
strategy("Quant Trend Engine [SMP]", overlay=true,
     initial_capital=1000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     commission_type=strategy.commission.percent, commission_value=0.05,
     slippage=2, pyramiding=0, process_orders_on_close=true,
     calc_on_every_tick=false)

// ─────────── Girdiler ───────────
grpS = "Sinyal"
// Varsayilanlar TF taramasinda (backtest/run_tf_sweep.py) 1D'de en iyi + en
// saglam cikan set: 55/20, trend200, ER0.50 (Sharpe 1.68, DD %5.7, 5/5 fold).
entryLen   = input.int(55,  "Giris Donchian (breakout)", minval=5,  group=grpS)
exitLen    = input.int(20,  "Cikis Donchian",            minval=3,  group=grpS)
trendLen   = input.int(200, "Trend EMA filtresi",        minval=20, group=grpS)
allowShort = input.bool(false, "Short'a izin ver (kripto'da onerilmez)", group=grpS)
useRegime  = input.bool(true,  "Rejim filtresi: sadece TREND rejiminde isle (ER)", group=grpS)
erLen      = input.int(20,   "ER penceresi", minval=5, group=grpS)
erThr      = input.float(0.50,"ER trend esigi (0.50 = valide)", step=0.05, minval=0.05, group=grpS)

grpR = "Risk / Boyutlandirma (volatilite hedefleme)"
targetVol = input.float(0.40, "Yillik hedef volatilite", step=0.05, minval=0.05, group=grpR)
volWin    = input.int(30,   "Vol penceresi (bar)", minval=10, group=grpR)
maxLev    = input.float(3.0, "Maks kaldirac (cap)", step=0.5, minval=0.1, group=grpR)
barsYear  = input.int(365,  "Yildaki bar (1D=365, 4H=2190)", group=grpR)
atrLen    = input.int(14,   "ATR uzunlugu", group=grpR)
atrTrail  = input.float(0.0,"ATR trailing stop x (0 = kapali)", step=0.5, minval=0.0, group=grpR)

grpT = "Tarih filtresi"
useDate  = input.bool(false, "Tarih araligi kullan", group=grpT)
startDate= input.time(timestamp("2020-01-01"), "Baslangic", group=grpT)
inWindow = not useDate or time >= startDate

// ─────────── Trend & sinyaller ───────────
emaTrend = ta.ema(close, trendLen)
trendUp  = close > emaTrend
trendDn  = close < emaTrend

// [1] ile kaydirma: kirilim seviyesi guncel barin KENDI high/low'unu icermez
upBreak = ta.highest(high, entryLen)[1]
dnBreak = ta.lowest(low,  entryLen)[1]
exitDn  = ta.lowest(low,  exitLen)[1]
exitUp  = ta.highest(high, exitLen)[1]

// Efficiency Ratio rejim filtresi (#1 — Python'da valide: Sharpe 0.65->1.15, DD yariya):
// sadece fiyat GERCEKTEN trend yapiyorsa (ER > esik) islem ac.
erChange = math.abs(close - close[erLen])
erPath   = math.sum(math.abs(close - close[1]), erLen)
er       = erPath == 0 ? 0.0 : erChange / erPath
regimeOk = not useRegime or er > erThr

longEntry  = inWindow and close > upBreak and trendUp and regimeOk
shortEntry = inWindow and allowShort and close < dnBreak and trendDn and regimeOk
longExit   = close < exitDn
shortExit  = close > exitUp

// ─────────── Volatilite-hedefli boyutlandirma ───────────
ret  = math.log(close / close[1])
rvol = ta.stdev(ret, volWin) * math.sqrt(barsYear)          // yillik gerceklesmis vol
lev  = na(rvol) or rvol == 0 ? 0.0 : math.min(targetVol / rvol, maxLev)
qty  = (strategy.equity * lev) / close                       // base birim adedi

// ─────────── Emirler ───────────
if longEntry and strategy.position_size <= 0
    strategy.entry("L", strategy.long, qty=qty)
if shortEntry and strategy.position_size >= 0
    strategy.entry("S", strategy.short, qty=qty)

if strategy.position_size > 0 and longExit
    strategy.close("L", comment="Donchian cikis")
if strategy.position_size < 0 and shortExit
    strategy.close("S", comment="Donchian cikis")

// ─────────── Opsiyonel ATR trailing stop (ratchet) ───────────
atr = ta.atr(atrLen)
var float longTrail  = na
var float shortTrail = na
if strategy.position_size > 0
    longTrail := na(longTrail) ? close - atr * atrTrail : math.max(longTrail, close - atr * atrTrail)
else
    longTrail := na
if strategy.position_size < 0
    shortTrail := na(shortTrail) ? close + atr * atrTrail : math.min(shortTrail, close + atr * atrTrail)
else
    shortTrail := na
if atrTrail > 0 and strategy.position_size > 0
    strategy.exit("L-trail", from_entry="L", stop=longTrail)
if atrTrail > 0 and strategy.position_size < 0
    strategy.exit("S-trail", from_entry="S", stop=shortTrail)

// ─────────── Gorseller ───────────
plot(emaTrend, "Trend EMA", color=color.orange, linewidth=2)
plot(upBreak,  "Giris breakout", color=color.new(color.green, 40))
plot(exitDn,   "Long cikis",     color=color.new(color.red, 40))
bgcolor(trendUp ? color.new(color.green, 92) : color.new(color.red, 94))
plotshape(longEntry,  "Long giris", shape.triangleup,   location.belowbar, color.new(color.green,0), size=size.tiny)
plotshape(longExit and strategy.position_size > 0, "Long cikis", shape.xcross, location.abovebar, color.new(color.gray,0), size=size.tiny)

// Dashboard
var table dash = table.new(position.top_right, 2, 5, border_width=1)
if barstate.islast
    table.cell(dash, 0, 0, "Rejim",   text_color=color.white, bgcolor=color.gray)
    table.cell(dash, 1, 0, trendUp ? "TREND ↑" : "TREND ↓", text_color=color.white, bgcolor=trendUp?color.green:color.red)
    table.cell(dash, 0, 1, "Kaldirac", text_color=color.white, bgcolor=color.gray)
    table.cell(dash, 1, 1, str.tostring(lev, "#.00"), text_color=color.black, bgcolor=color.silver)
    table.cell(dash, 0, 2, "Yil. Vol", text_color=color.white, bgcolor=color.gray)
    table.cell(dash, 1, 2, str.tostring(rvol*100, "#.0")+"%", text_color=color.black, bgcolor=color.silver)
    table.cell(dash, 0, 3, "Poz",      text_color=color.white, bgcolor=color.gray)
    table.cell(dash, 1, 3, strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT", text_color=color.black, bgcolor=color.silver)
    table.cell(dash, 0, 4, "ER rejim", text_color=color.white, bgcolor=color.gray)
    table.cell(dash, 1, 4, str.tostring(er, "#.00") + (regimeOk ? " TREND" : " YATAY"), text_color=color.black, bgcolor=regimeOk ? color.new(color.green, 40) : color.new(color.orange, 40))

// ─────────── Alarmlar (tarayici entegrasyonu icin) ───────────
alertcondition(longEntry, "Long Giris", "Quant Trend LONG: {{ticker}} @ {{close}}")
alertcondition(longExit,  "Long Cikis", "Quant Trend EXIT: {{ticker}} @ {{close}}")
